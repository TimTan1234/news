# Needed for article summaries and the daily briefing, and lets suggestions learn
# new interests and explain each pick.
ANTHROPIC_API_KEY=

# Optional: scores how relevant each suggested story is. Get a key in Google AI Studio.
GEMINI_API_KEY=

# Optional: lets the home feed recognise one story reported by several sources in different
# words, including across Chinese and English. In the Cloudflare dashboard, copy the account
# ID and create an API token from the "Workers AI" template. It runs on the free allowance
# of 10,000 Neurons a day; a new account's first refresh uses about 1,700.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: adds YouTube to search and suggestions. Enable "YouTube Data API v3" in
# the Google Cloud console and create an API key. Allows about 100 searches a day.
YOUTUBE_API_KEY=

# Optional: lets each person connect their YouTube account so suggestions learn from
# their likes and subscriptions. Create an OAuth client ID of type "TVs and Limited
# Input devices" in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, for Weibo search and Zhihu feeds. Sign in to the site in a browser,
# open the developer tools, and copy the Cookie header of any request to it.
WEIBO_COOKIES=
ZHIHU_COOKIES=

# Optional: the username of the account that manages the shared Xiaohongshu login.
# Without it, that is the first account created.
ADMIN_USER=

# Optional: the site the Xiaohongshu login belongs to. The default, www.rednote.com, is for
# accounts registered with a phone number from outside China; the other is www.xiaohongshu.com.
XHS_SITE_HOST=
