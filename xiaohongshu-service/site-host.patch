--- /dev/null
+++ b/xiaohongshu/site.go
@@ -0,0 +1,14 @@
+package xiaohongshu
+
+import "os"
+
+// siteHost 登录和搜索所用的站点域名。
+//
+// 海外手机号注册的账号属于 rednote.com，登录态只在那边有效；
+// 设置 XHS_SITE_HOST=www.rednote.com 即可改用海外站，默认仍是 www.xiaohongshu.com。
+func siteHost() string {
+	if host := os.Getenv("XHS_SITE_HOST"); host != "" {
+		return host
+	}
+	return "www.xiaohongshu.com"
+}
